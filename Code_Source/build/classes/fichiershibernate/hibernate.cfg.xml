package fichiershibernate;

import org.hibernate.cfg.Configuration;
import org.hibernate.SessionFactory;

public class NewHibernateUtil {

    private static final SessionFactory sessionFactory;
    
    static {
        try {
            // Crée la SessionFactory à partir du fichier de configuration hibernate.cfg.xml
            sessionFactory = new Configuration().configure("fichiershibernate/hibernate.cfg.xml").buildSessionFactory();
        } catch (Throwable ex) {
            // Log l'exception pour savoir s'il y a un problème de configuration
            System.err.println("La création initiale de la SessionFactory a échoué. " + ex);
            throw new ExceptionInInitializerError(ex);
        }
    }
    
    public static SessionFactory getSessionFactory() {
        return sessionFactory;
    }
}